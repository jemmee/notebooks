0 REM pip install pcbasic
1 REM pcbasic bloom_filter_test.bas
10 CLS: PRINT "--- BLOOM FILTER DEMO: MESSENGER OF THE KINGS ---"
20 REM INITIALIZE BIT ARRAY (SIZE 20)
30 DIM B(20): FOR I = 0 TO 20: B(I) = 0: NEXT I
40 REM --- ADD 'ASA' TO THE FILTER ---
50 S$ = "ASA": GOSUB 200: PRINT "ADDED: "; S$
60 REM --- ADD 'JUDAH' TO THE FILTER ---
70 S$ = "JUDAH": GOSUB 200: PRINT "ADDED: "; S$
80 PRINT "------------------------------------------------"
90 REM --- TEST INPUT ---
100 INPUT "ENTER A NAME TO CHECK: ", T$
110 S$ = T$: GOSUB 300
120 IF F = 1 THEN PRINT T$; " MIGHT BE IN THE SET." ELSE PRINT T$; " IS DEFINITELY NOT IN THE SET."
130 GOTO 100
140 END
150 '
200 REM --- SUBROUTINE: HASH & ADD ---
210 H1 = (LEN(S$) * ASC(LEFT$(S$,1))) MOD 20
220 H2 = (LEN(S$) * ASC(RIGHT$(S$,1))) MOD 20
230 B(H1) = 1: B(H2) = 1: RETURN
240 '
300 REM --- SUBROUTINE: TEST ---
310 H1 = (LEN(S$) * ASC(LEFT$(S$,1))) MOD 20
320 H2 = (LEN(S$) * ASC(RIGHT$(S$,1))) MOD 20
330 IF B(H1) = 1 AND B(H2) = 1 THEN F = 1 ELSE F = 0
340 RETURN