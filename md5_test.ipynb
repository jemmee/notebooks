   "source": [
    "import hashlib\n",
    "\n",
    "# The string we want to hash\n",
    "data = \"Hello World\"\n",
    "\n",
    "# 1. Create an md5 hash object\n",
    "hash_object = hashlib.md5(data.encode())\n",
    "\n",
    "# 2. Get the hexadecimal representation of the hash\n",
    "hex_dig = hash_object.hexdigest()\n",
    "\n",
    "print(f\"Data: {data}\")\n",
    "print(f\"MD5 Hash: {hex_dig}\")"
   ]
  },
